<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_visit"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visitor_required"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spVisitor"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnNewVisitor"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/new_visitor"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:backgroundTint="@color/accent_bg"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/host_required"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spHost"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/date_time_required"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etScheduled"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/choose_date_time"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:autofillHints=""
            android:background="@drawable/input_bg"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_subtle"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purpose_required"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPurpose"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/visit_purpose"
            android:inputType="text"
            android:autofillHints=""
            android:background="@drawable/input_bg"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_subtle"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notes_label"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:hint="@string/notes_optional"
            android:inputType="textMultiLine"
            android:autofillHints=""
            android:gravity="top"
            android:background="@drawable/input_bg"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_subtle"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:backgroundTint="@color/surface2"
                android:textColor="@color/text_muted" />

            <Button
                android:id="@+id/btnCreate"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/create"
                android:textAllCaps="false"
                android:backgroundTint="@color/accent"
                android:textColor="#FFFFFF"
                android:layout_marginStart="10dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>